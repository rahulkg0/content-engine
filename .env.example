# Database & Storage Settings
DATABASE_URL=sqlite+aiosqlite:///./content_engine.db
# For PostgreSQL in production/docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/content_engine

# Redis & Celery Settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider (OpenRouter API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_RESEARCH_MODEL=deepseek/deepseek-v4-flash-0731:free
DEFAULT_WRITER_MODEL=deepseek/deepseek-v4-flash-0731:free
DEFAULT_QUALITY_MODEL=deepseek/deepseek-v4-flash-0731:free


# Strapi CMS Integration Settings
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here
STRAPI_CONTENT_TYPE=articles

# Operating Mode
DEMO_MODE=true

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
